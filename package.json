{
  "name": "uniconvert-monorepo",
  "version": "1.2.3",
  "private": true,
  "description": "A universal file converter for images, videos, audio and documents",
  "workspaces": ["packages/*"],
  "trustedDependencies": [
    "electron",
    "electron-winstaller",
    "esbuild",
    "ffmpeg-static",
    "puppeteer",
    "register-scheme",
    "sharp"
  ],
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON \"bun --filter @uniconvert/renderer dev\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 bun --filter @uniconvert/electron-app dev\"",
    "build": "bun --filter '*' build",
    "test": "bun --filter '*' test",
    "release": "bun --filter @uniconvert/electron-app release && bun run release:organize",
    "release:build": "bun --filter @uniconvert/electron-app release:build && bun run release:organize",
    "release:publish": "bun --filter @uniconvert/electron-app release:publish && bun run release:organize",
    "release:organize": "node scripts/organize-release.js",
    "prepare:icons": "node scripts/gen-icon.js"
  },
  "keywords": [],
  "author": "0png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0png/uniconverter.git"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "fast-check": "^4.5.3",
    "vitest": "^4.0.17",
    "wait-on": "^9.0.4"
  }
}
